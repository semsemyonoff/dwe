# Binaries (anchored: nested bin/ dirs like shimassets/bin hold committed files)
/bin/
/dwe
*.test

# IDE & OS
.idea/
.vscode/
.zed/
*~
.DS_Store

# tools
.ralphex/

# Generated: synced from docs/ by scripts/sync-embedded-docs.sh on `make build`
# and `make test*` (which depend on the embedded-docs target).
/internal/core/docs/embedded/

# Generated: bridge shims cross-compiled by scripts/build-shims.sh on
# `make build` and `make test*` (which depend on the shims target). The
# committed bin/.gitkeep keeps the //go:embed all:bin pattern matching on a
# fresh checkout.
/internal/core/bridge/shimassets/bin/shim-*

# Release artifacts (GoReleaser output and generated completion scripts).
/dist/
/completions/

# Docs site (web/): dependencies, Astro build output, and the content tree +
# sidebar generated from docs/ by web/scripts/sync-docs.mjs on `npm run sync`
# (which `predev`/`prebuild` run automatically). Same generated-tree pattern as
# internal/core/docs/embedded/ above.
/web/node_modules/
/web/dist/
/web/.astro/
/web/public/
/web/src/assets/
/web/src/content/docs/
/web/src/sidebar.generated.mjs
/web/src/version.generated.mjs
