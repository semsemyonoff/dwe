#!/bin/sh
# Ralphex's fingerprints must include only the repositories named for this run.
set -eu

fail() {
  printf 'ws-git: %s\n' "$*" >&2
  exit 1
}

root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd -P)
cd "$root"
run=.ralphex/run
scope=.
newline='
'
has_state=false

read_setting() {
  [ -f "$1" ] && [ ! -L "$1" ] || fail "missing ordinary state file: $1"
  {
    setting=
    IFS= read -r setting || [ -n "$setting" ] || fail "$1 must contain one nonempty line"
    [ -n "$setting" ] || fail "$1 must contain one nonempty line"
    extra=
    if IFS= read -r extra || [ -n "$extra" ]; then
      fail "$1 must contain one nonempty line"
    fi
  } < "$1"
  printf '%s\n' "$setting"
}

# Normalize aliases before deduplication and check every component for symlinks.
normalize_repo() {
  case "$1" in
    ''|/*) fail "invalid repository path: $1" ;;
  esac
  rest=$1
  normalized=.
  while [ -n "$rest" ]; do
    component=${rest%%/*}
    case "$rest" in
      */*) rest=${rest#*/} ;;
      *) rest= ;;
    esac
    case "$component" in
      ..) fail "repository path contains ..: $1" ;;
      ''|.) continue ;;
    esac
    if [ "$normalized" = . ]; then
      normalized=$component
    else
      normalized=$normalized/$component
    fi
    [ ! -L "$normalized" ] || fail "symlinked repository path: $1"
  done
}

# Case-insensitive filesystems (default APFS) answer loose refs under any case.
lowercase() {
  printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]'
}

if [ -e "$run" ] || [ -L "$run" ]; then
  [ -d "$run" ] && [ ! -L "$run" ] || fail "run state must be an ordinary directory: $run"
  has_state=true
  base_ref=$(read_setting "$run/base-ref")
  task_branch=$(read_setting "$run/task-branch")
  case "$base_ref" in -*) fail "invalid base ref: $base_ref" ;; esac
  case "$task_branch" in -*) fail "invalid task branch: $task_branch" ;; esac
  branch_name=$(git check-ref-format --branch "$task_branch") || fail "invalid task branch: $task_branch"
  [ "$branch_name" = "$task_branch" ] || fail "task branch must be a literal branch name: $task_branch"
  # Git's DWIM resolves NAME, heads/NAME and refs/heads/NAME through the branch,
  # and HEAD/@ follow whatever is checked out: such a base would track the task
  # tip. Compare the ref part before any revision suffix (~ ^ : @{), ignoring
  # case because a case-insensitive filesystem resolves every case variant.
  base_lower=$(lowercase "$base_ref")
  branch_lower=$(lowercase "$task_branch")
  base_name=${base_lower%%[\~^:]*}
  base_name=${base_name%%@\{*}
  case "$base_name" in
    ''|@|head|"$branch_lower"|"heads/$branch_lower"|"refs/heads/$branch_lower")
      fail "base ref must not resolve through HEAD or the task branch: $base_ref"
      ;;
  esac
  [ -f "$run/repos" ] && [ ! -L "$run/repos" ] || fail "missing ordinary state file: $run/repos"
  saw_repo=false
  while IFS= read -r repo || [ -n "$repo" ]; do
    normalize_repo "$repo"
    saw_repo=true
    case "$newline$scope$newline" in
      *"$newline$normalized$newline"*) ;;
      *) scope=$scope$newline$normalized ;;
    esac
  done < "$run/repos"
  [ "$saw_repo" = true ] || fail "$run/repos must not be empty"
fi

operation=git
case "${1:-}" in
  ws-check|ws-status|ws-log|ws-prepare)
    [ "$#" -eq 1 ] || fail "usage: $1"
    operation=$1
    ;;
  ws-diff|ws-wip)
    [ "$#" -eq 1 ] || { [ "$#" -eq 2 ] && [ "$2" = --stat ]; } || fail "usage: $1 [--stat]"
    operation=$1
    ;;
  ws-*) fail "unknown workspace command: $1" ;;
esac

if [ "$operation" != git ] && [ "$has_state" = false ]; then
  fail "missing run state; configure $run/{repos,base-ref,task-branch} first"
fi

# Ralphex creates or switches to --branch in the root only while the root is on
# its default_branch; without the setting ralphex treats main or master as default.
default_branch=
if [ "$operation" = ws-check ] || [ "$operation" = ws-prepare ]; then
  if [ -f .ralphex/config ]; then
    default_branch=$(awk '
      index($0, "=") {
        key = substr($0, 1, index($0, "=") - 1)
        gsub(/^[ \t]+|[ \t]+$/, "", key)
        if (key != "default_branch") next
        value = substr($0, index($0, "=") + 1)
        gsub(/^[ \t]+|[ \t]+$/, "", value)
        branch = value
      }
      END { print branch }
    ' .ralphex/config)
  fi
fi

is_default_branch() {
  if [ -n "$default_branch" ]; then
    [ "$1" = "$default_branch" ]
  else
    [ "$1" = main ] || [ "$1" = master ]
  fi
}

# Git diagnostics (e.g. ambiguous ref warnings) are silenced during validation:
# ralphex hashes the combined output of intercepted calls, and failures report
# their own message.
is_ancestor() {
  git -C "$repo" merge-base --is-ancestor "$1" "$2" 2>/dev/null
}

# show-ref matches the exact ref only; rev-parse would also DWIM other refs.
has_task_branch() {
  git -C "$repo" show-ref --verify --quiet "refs/heads/$task_branch"
}

check_branch() {
  if [ "$current" = "$task_branch" ]; then
    is_ancestor "$base_ref" HEAD || fail "$repo: configured base is not an ancestor of HEAD"
  elif [ "$repo" = . ] && is_default_branch "$current"; then
    target=HEAD
    if has_task_branch; then
      target=refs/heads/$task_branch
    fi
    is_ancestor "$base_ref" "$target" || fail "$repo: configured base is not an ancestor of $target"
  elif [ "$repo" = . ]; then
    fail "$repo: expected task branch $task_branch or default branch ${default_branch:-main/master}, found $current"
  else
    fail "$repo: expected task branch $task_branch, found $current"
  fi
}

# Everything ws-prepare could reject, and everything the strict ws-check will
# require of the prepared state, is checked in every repository before the
# first tag or branch is written.
check_prepare() {
  git -C "$repo" rev-parse --verify --quiet HEAD >/dev/null 2>&1 || fail "$repo: HEAD does not point to a commit"
  if base_commit=$(git -C "$repo" rev-parse --verify --quiet --end-of-options "$base_ref^{commit}" 2>/dev/null); then
    :
  else
    git check-ref-format "refs/tags/$base_ref" ||
      fail "$repo: base does not resolve and is not a valid tag name: $base_ref"
    # A tag named like a ref path would be ambiguous with the ref it spells.
    case "$base_lower" in
      refs/*|heads/*|tags/*|remotes/*)
        fail "$repo: base does not resolve and cannot become a tag named like a ref path: $base_ref"
        ;;
    esac
    if git -C "$repo" show-ref --verify --quiet "refs/tags/$base_ref"; then
      fail "$repo: tag $base_ref does not point to a commit"
    fi
    base_commit=$(git -C "$repo" rev-parse --verify HEAD)
  fi
  current=$(git -C "$repo" symbolic-ref --quiet HEAD 2>/dev/null) || current=
  current=${current#refs/heads/}
  if has_task_branch; then
    is_ancestor "$base_commit" "refs/heads/$task_branch" ||
      fail "$repo: existing branch $task_branch does not contain base $base_ref"
  elif [ "$repo" = . ] && is_default_branch "$current"; then
    # The root stays here and ralphex branches from HEAD at launch.
    is_ancestor "$base_commit" HEAD ||
      fail "$repo: base $base_ref is not an ancestor of HEAD on default branch $current"
  fi
}

# Validate the entire scope before any output, including the implicit root.
while IFS= read -r repo; do
  [ -d "$repo/.git" ] && [ ! -L "$repo/.git" ] || fail "missing ordinary checkout: $repo"
  [ "$has_state" = true ] || continue
  if [ "$operation" = ws-prepare ]; then
    check_prepare
    continue
  fi
  git -C "$repo" rev-parse --verify --quiet --end-of-options "$base_ref^{commit}" >/dev/null 2>&1 ||
    fail "$repo: configured base does not resolve: $base_ref"
  [ "$operation" != git ] || continue
  current=$(git -C "$repo" symbolic-ref --quiet HEAD 2>/dev/null) || fail "$repo: detached HEAD"
  current=${current#refs/heads/}
  case "$operation" in
    ws-check) check_branch ;;
    ws-log|ws-diff|ws-wip)
      [ "$current" = "$task_branch" ] || fail "$repo: expected task branch $task_branch, found $current"
      is_ancestor "$base_ref" HEAD || fail "$repo: configured base is not an ancestor of HEAD"
      ;;
  esac
done <<EOF
$scope
EOF

if [ "$operation" = git ]; then
  if [ "$#" -eq 2 ] && [ "$1" = rev-parse ] && [ "$2" = HEAD ]; then
    operation='head'
  elif [ "$#" -eq 2 ] && [ "$1" = diff ] && [ "$2" = HEAD ]; then
    operation='diff'
  elif [ "$#" -eq 4 ] && [ "$1" = ls-files ] && [ "$2" = -z ] &&
    [ "$3" = --others ] && [ "$4" = --exclude-standard ]; then
    operation=untracked
  else
    exec git "$@"
  fi
fi

scratch=$(mktemp -d "${TMPDIR:-/tmp}/ws-git.XXXXXX")
trap 'rm -rf "$scratch"' 0
trap 'exit 1' HUP INT TERM

untracked() {
  # Separate Git from xargs: POSIX pipelines would hide a failed Git exit code.
  git -C "$repo" ls-files -z --others --exclude-standard > "$scratch/untracked"
  # Expansion belongs to the child shell, after xargs has split the NUL records.
  # shellcheck disable=SC2016
  xargs -0 sh -c '
    prefix=$1
    shift
    for file do printf "%s%s\000" "$prefix" "$file"; done
  ' sh "$prefix" < "$scratch/untracked"
}

prepare_repo() {
  if ! git -C "$repo" rev-parse --verify --quiet --end-of-options "$base_ref^{commit}" >/dev/null; then
    git -C "$repo" tag --end-of-options "$base_ref" HEAD || fail "$repo: cannot create tag $base_ref"
    printf '%s: created tag %s at HEAD\n' "$label" "$base_ref"
  fi
  current=$(git -C "$repo" symbolic-ref --quiet HEAD) || current=
  current=${current#refs/heads/}
  if [ "$current" = "$task_branch" ]; then
    printf '%s: on %s\n' "$label" "$task_branch"
  elif [ "$repo" = . ] && is_default_branch "$current"; then
    printf '%s: left on %s; ralphex switches to %s at launch\n' "$label" "$current" "$task_branch"
  elif has_task_branch; then
    git -C "$repo" switch --quiet --end-of-options "$task_branch" || fail "$repo: cannot switch to $task_branch"
    printf '%s: switched to %s\n' "$label" "$task_branch"
  else
    # --no-track keeps a remote-tracking base from becoming the task branch upstream.
    git -C "$repo" switch --quiet --no-track --create "$task_branch" --end-of-options "$base_ref" ||
      fail "$repo: cannot create $task_branch from $base_ref"
    printf '%s: created %s from %s\n' "$label" "$task_branch" "$base_ref"
  fi
}

while IFS= read -r repo; do
  label=$repo
  prefix=$repo/
  if [ "$repo" = . ]; then
    label=workspace
    prefix=
  fi
  case "$operation" in
    head)
      head=$(git -C "$repo" rev-parse HEAD)
      printf '%s %s\n' "$repo" "$head" >> "$scratch/heads"
      ;;
    diff)
      git -C "$repo" --no-pager diff --src-prefix="a/$prefix" --dst-prefix="b/$prefix" HEAD
      ;;
    untracked) untracked ;;
    ws-prepare) prepare_repo ;;
    ws-check)
      current=$(git -C "$repo" symbolic-ref --quiet HEAD)
      printf '%s: branch=%s base=%s task=%s\n' "$label" "${current#refs/heads/}" "$base_ref" "$task_branch"
      ;;
    ws-status)
      git -C "$repo" status --porcelain > "$scratch/status"
      if [ -s "$scratch/status" ]; then
        printf '### %s\n' "$label"
        cat "$scratch/status"
      fi
      ;;
    ws-log)
      printf '### %s (base: %s)\n' "$label" "$base_ref"
      git -C "$repo" --no-pager log --oneline "$base_ref..HEAD"
      ;;
    ws-diff|ws-wip)
      if [ "$operation" = ws-wip ]; then
        git -C "$repo" status --porcelain > "$scratch/status"
        [ -s "$scratch/status" ] || continue
        comparison=HEAD
      else
        comparison=$base_ref...HEAD
      fi
      printf '### %s (base: %s)\n' "$label" "$base_ref"
      if [ "$#" -eq 2 ]; then
        git -C "$repo" --no-pager diff --src-prefix="a/$prefix" --dst-prefix="b/$prefix" --stat "$comparison"
      else
        git -C "$repo" --no-pager diff --src-prefix="a/$prefix" --dst-prefix="b/$prefix" "$comparison"
      fi
      if [ "$operation" = ws-wip ]; then
        git -C "$repo" ls-files -z --others --exclude-standard > "$scratch/untracked"
        # shellcheck disable=SC2016
        xargs -0 sh -c '
          prefix=$1
          shift
          for file do printf "untracked: %s%s\n" "$prefix" "$file"; done
        ' sh "$prefix" < "$scratch/untracked"
      fi
      ;;
  esac
done <<EOF
$scope
EOF

if [ "$operation" = head ]; then
  git hash-object --stdin < "$scratch/heads"
fi
