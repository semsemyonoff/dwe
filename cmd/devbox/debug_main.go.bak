// Temp debug file
package main

import (
	"fmt"
	"devbox-cli/internal/config"
)

func debugMain() {
	cfg, err := config.LoadConfig("devbox.yml")
	if err != nil {
		panic(err)
	}
	for name, svc := range cfg.Services {
		fmt.Printf("service %s: container=%q, dir_internal=%q\n", name, svc.Container, svc.DirInternal)
	}
}
