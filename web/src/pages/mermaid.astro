---
// Standalone full-window Mermaid view — the target of each diagram's ↗ "open in
// new tab" control. The source travels in the URL hash (see encodeSource), so it
// never reaches the server. A plain Astro page, deliberately outside the Starlight
// chrome; all rendering happens client-side in src/scripts/mermaid-standalone.js.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Diagram · DWE</title>
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        background: #1b1b1f;
        font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      }
      #mz-root,
      #mz-root .mz,
      #mz-root .mz-viewport {
        height: 100vh;
      }
    </style>
  </head>
  <body>
    <div id="mz-root"></div>
    <script>
      import('/src/scripts/mermaid-standalone.js');
    </script>
  </body>
</html>
