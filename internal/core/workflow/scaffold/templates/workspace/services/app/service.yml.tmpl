# workspace/services/[[ .Service ]]/service.yml — the "[[ .Service ]]" starter service.
#
# type + container are active; every other field is an optional, commented
# example. The folder name ([[ .Service ]]) is the service's map key — there is
# no `name:` field. Run `dwe docs show config/services/index`.

type: app
container: "[[ .Service | yamlEsc ]]"

# required: true              # always-on; removes the enable/disable toggle
# dir: "./[[ .Service ]]"            # host source directory for this app
# depends_on: []
# ports:
#   http: 8080
# hosts:
#   web: "[[ .Service ]].localhost"
# icon: "📦"
# render:
#   ide:
#     enabled: true
