# workspace/styles.yml — CLI branding and semantic color palette.
#
# Omitting this file entirely produces the built-in defaults. Empty / missing
# color tokens fall back to the built-in light or dark default for that token.
# Run `dwe docs config styles`.

header:
[[- if .Branding.Title ]]
  lines:
    - "[[ .Branding.Title | yamlEsc ]]"
[[- else ]]
  # lines:
  #   - "Welcome to"
  #   - "My Project"
[[- end ]]
  # font: doom
[[- if .Branding.Tagline ]]
  tagline: "[[ .Branding.Tagline | yamlEsc ]]"
[[- else ]]
  # tagline: "Local dev, container-orchestrated."
[[- end ]]

colors:
[[- if .Branding.Accent ]]
  accent:  "[[ .Branding.Accent | yamlEsc ]]"
[[- else ]]
